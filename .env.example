# Google OAuth Client ID for Google Drive sync
# Create one at: https://console.cloud.google.com/apis/credentials
# Enable the Google Drive API and configure the OAuth consent screen
# Set "Authorized JavaScript origins" to your app's URL (e.g., http://localhost:5173)
# Set "Authorized redirect URIs" to the same URL (e.g., http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
